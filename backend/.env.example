# ── Aplicación ────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # DEBE ser false en producción (se valida al arrancar)
CORS_ORIGINS=http://localhost:5173

# ── Base de datos (Supabase → Project Settings → Database) ───
# Usa el string del pooler (Supavisor). Codifica en URL los caracteres especiales de la contraseña (@ → %40).
# Se convierte automáticamente a postgresql+asyncpg://
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
DB_BEHIND_POOLER=true            # true con Supavisor/PgBouncer en modo transacción (puerto 6543)
DB_REQUIRE_SSL=true              # pon false solo con un Postgres local de desarrollo

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Solo si tu proyecto aún firma con la clave HS256 legacy. Con claves asimétricas (ES256/RS256) déjalo vacío.
SUPABASE_JWT_SECRET=
# Solo backend, nunca en el frontend. Se usará en el módulo de Storage (paso 3).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Administración y renovaciones manuales ───────────────────────────────
# Lista separada por comas de correos que ya existen en Supabase Auth. Nunca guardes contraseñas aquí.
ADMIN_EMAILS=
PRIVACY_POLICY_VERSION=2026-10-27-v2
BILLING_GRACE_DAYS=2
BILLING_TRIAL_DAYS=6
BILLING_MONTHLY_PRICE_COP=15000
BILLING_EXTRA_CATALOG_PRICE_COP=5000
# Número E.164 del WhatsApp al que los vendedores deben solicitar pagos (ej. +573001234567).
BILLING_WHATSAPP_NUMBER=
APP_TIMEZONE=America/Bogota
MAX_PRODUCT_IMAGE_BYTES=2097152

# ── Proveedores opcionales de avisos ─────────────────────────────────────
# Copia estos valores al archivo C:\Catalogos saas\.env (solo backend).
# No pongas credenciales SMTP ni tokens de WhatsApp en el frontend.
# SMTP: 587 usa STARTTLS (SMTP_USE_SSL=false); 465 usa SSL (SMTP_USE_SSL=true).
# SMTP_FROM_EMAIL debe ser una dirección verificada en el proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_NAME: plantilla aprobada para avisos de suscripción;
# cuerpo con {{1}} = nombre del vendedor y {{2}} = aviso.
# WHATSAPP_ORDER_TEMPLATE_NAME: plantilla aprobada de pedido;
# cuerpo con {{1}} = detalle del pedido enviado al vendedor.
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_CO
WHATSAPP_GRAPH_API_VERSION=

# ── Reglas de negocio ────────────────────────────────────────
MAX_PRODUCTS_PER_STORE=50
